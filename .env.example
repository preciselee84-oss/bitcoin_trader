STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
TRAILING_STOP_PCT=1.8
CHECK_INTERVAL_SECONDS=300
DRY_RUN=true
LOG_FILE=trading.log

# Telegram alerts
TELEGRAM_TOKEN=your_telegram_bot_token
